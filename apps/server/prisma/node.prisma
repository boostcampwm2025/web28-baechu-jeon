enum DiagramType {
  STEP1
  STEP2
  STEP3
}

enum NodeType {
  FOLDER
  FILE
}

enum NodeGroup {
  FE
  BE
  INFRA
  DB
  EXTRA
}

model Node {
  id              BigInt @id @default(autoincrement())
  visualizationId String @map("visualization_id") @db.Uuid
  diagramType     DiagramType @map("diagram_type")
  x               Float  @default(0) @db.Real
  y               Float  @default(0) @db.Real
  label           String @db.VarChar
  contents        String? @db.Text
  relatedNodeIds  BigInt[] @default([]) @map("related_node_ids")
  relatedPaths    String[] @default([]) @map("related_paths")
  type            NodeType?
  groups          NodeGroup?

  visualization Visualization @relation(fields: [visualizationId], references: [id], onDelete: Cascade)

  outgoingEdges Edge[] @relation("SourceNode")
  incomingEdges Edge[] @relation("TargetNode")
  
  @@map("nodes")
  @@index([visualizationId, diagramType])
}
