// Node 테이블 스키마

model Node {
  id              String  @id @default(uuid()) @db.Uuid
  visualizationId String @map("visualization_id") @db.Uuid
  x               Float  @default(0) @db.Real
  y               Float  @default(0) @db.Real
  label           String @db.VarChar
  contents        String @db.Text
  groups          String? @db.Text

  visualization Visualization @relation(fields: [visualizationId], references: [id], onDelete: Cascade)

  sources Edge[] @relation("SourceNode")
  targets Edge[] @relation("TargetNode")

  @@map("nodes")
}
