// Node 테이블 스키마

model Node {
  id               BigInt @id @default(autoincrement())
  visualization_id String @db.Uuid
  x                Float
  y                Float
  label            String @db.VarChar
  contents         String @db.Text
  groups           String @db.Text

  visualization Visualization @relation(fields: [visualization_id], references: [id], onDelete: Cascade)

  @@map("nodes")
}